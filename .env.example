# OpenRoom environment example. Copy to .env.local for local work.
#
# OpenRoom is a static front end: it ships no server and reads no secret at
# runtime. This file holds two kinds of value and nothing else — build-time
# public flags, which Next inlines into the browser bundle from whatever
# environment runs the build (locally, or the Cloudflare Pages build
# environment), and keys that only developer-run scripts read from .env.local.
# No Shopify token is ever needed.

# Commerce mode: demo (default; no external requests) or shopify.
NEXT_PUBLIC_COMMERCE_PROVIDER=demo

# Bare store host, e.g. your-store.myshopify.com. Used for cart permalinks
# (https://<domain>/cart/<variantId>:<qty>) and the Storefront MCP endpoint
# (https://<domain>/api/mcp). Required when NEXT_PUBLIC_COMMERCE_PROVIDER=shopify.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Optional: map demo product ids to Shopify variant GIDs without editing
# src/features/commerce/shopify-variants.ts. Comma-separated productId=gid pairs;
# entries here override the file. Example:
# NEXT_PUBLIC_SHOPIFY_VARIANTS=hinoki-low-sofa=gid://shopify/ProductVariant/1234567890,oak-frame-table=gid://shopify/ProductVariant/2345678901
NEXT_PUBLIC_SHOPIFY_VARIANTS=

# Script-only variables for the offline asset pipelines (`pnpm assets:views`
# and `pnpm assets:products`, see docs/asset-views.md). Only
# scripts/openroom-assets/ reads them, from .env.local; they are never inlined
# into any bundle, never reach the client, and the app never calls an image
# model at runtime. Leave them empty unless you are regenerating cutouts; set
# the key of whichever provider you use, and Gemini is the default when
# GEMINI_API_KEY is the only one present.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider. Unset picks gemini when only GEMINI_API_KEY is
# set and openai when only OPENAI_API_KEY is set.
# OPENROOM_IMAGE_PROVIDER=gemini
OPENROOM_IMAGE_MODEL_GEMINI=gemini-3.1-flash-image
OPENROOM_IMAGE_MODEL=gpt-image-1
OPENROOM_IMAGE_QUALITY=high

# The Shopify development-store seed kit reads its own keys from this file too;
# see examples/shopify/.env.example for those.
