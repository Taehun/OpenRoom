# Seed-kit environment. Copy these keys into .env.local at the REPOSITORY ROOT
# (git-ignored) and fill them in. Only the scripts in this folder read them;
# nothing here is inlined into a bundle, reaches the browser, or runs in CI,
# and OpenRoom itself never holds a Shopify token.

# The development store, without a scheme. Required by shop:seed and shop:variants.
# Shopify appends a suffix to the name you chose, so copy the real domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token. Since 1 January 2026 Shopify no longer issues
# permanent shpat_ tokens for new apps: create an app in the Dev Dashboard
# (https://dev.shopify.com/dashboard) with these scopes, release a version,
# install it on the store, then exchange its Client ID and secret for a token
# that lives 24 hours:
#
#   read_products,write_products,write_publications,
#   write_online_store_navigation,write_online_store_pages
#
# The first three cover shop:seed, shop:variants, and shop:collections. The
# last two are only needed by shop:content, which writes the pages and menus;
# without them that script stops and names them.
#
#   curl -s -X POST "https://$SHOPIFY_STORE_DOMAIN/admin/oauth/access_token" \
#     -H "Content-Type: application/x-www-form-urlencoded" \
#     -d grant_type=client_credentials \
#     -d client_id=$SHOPIFY_CLIENT_ID -d client_secret=$SHOPIFY_CLIENT_SECRET
#
# Placeholder only — never commit a real token.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# The Dev Dashboard app's credentials, from its App settings tab. No script
# reads these; they live here so the token above can be re-minted after it
# expires. Never commit the secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin GraphQL API version the scripts call.
SHOPIFY_API_VERSION=2026-01

# Where the product cutouts are served from. The deployed Pages build is the
# default; point this at any host Shopify can fetch the images from.
OPENROOM_IMAGE_BASE=https://openroom-webmcp.pages.dev
