# Seed-kit environment. Copy these keys into .env.local at the REPOSITORY ROOT
# (git-ignored) and fill them in. Only the three scripts in this folder read
# them; nothing here is inlined into a bundle, reaches the browser, or runs in
# CI, and OpenRoom itself never holds a Shopify token.

# The development store, without a scheme. Required by shop:seed and shop:variants.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token of a custom app in that store, with the scopes
# read_products, write_products, write_publications. Placeholder only — never
# commit a real token.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...

# Admin GraphQL API version the scripts call.
SHOPIFY_API_VERSION=2026-01

# Where the product cutouts are served from. The deployed Pages build is the
# default; point this at any host Shopify can fetch the images from.
OPENROOM_IMAGE_BASE=https://openroom-webmcp.pages.dev
